[configuration]

entry_symbol = "library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/GDGameLights.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://bin/GDGameLights.windows.template_debug.x86_64.dll"
linux.release.x86_64 = "res://bin/GDGameLights.linux.template_release.x86_64.so"
windows.release.x86_64 = "res://bin/GDGameLights.windows.template_debug.x86_64.dll"

[icons]
GDGameLights = "res://bin/icons/gamepad-solid.svg"